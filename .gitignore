# Dependencies
node_modules/

# Build output
dist/
out/
release/
*.tsbuildinfo
# tsc 编译产物（build 输出 dist/；开发期 .js 就地输出忽略，手写 .js 按下方反排除入库）
# 注：/src/**/*.ts 宽泛忽略已移除（v0.1.4 教训：新增 src 子目录被静默吞，四次断链——.ts 源码永远入库）
src/**/*.js
src/**/*.js.map
# 显式保留手写源（覆盖默认）
!src/renderer/kanban.js
!src/renderer/kanban.css
# S1/S2 Skills 子系统手写源（同 kanban 先例；否则新 .ts/.js 静默被忽略不进版本库）
!src/skills/
!src/skills/**/*.ts
!src/renderer/skills.js
# P1 pkgMgr 包管理器执行器手写源（同 skills 先例——新目录默认被 /src/**/*.ts 忽略）
!src/overlay/pkgMgr/
!src/overlay/pkgMgr/**/*.ts
# PK2 extractNode 捆绑 node 解压手写源（同 pkgMgr 先例）
!src/overlay/extractNode.ts
!src/overlay/extractNode.test.ts
# T-Token 消耗模块手写源（同 extractNode 先例；否则新 .ts/.js 静默被忽略不进版本库）
!src/renderer/tokens.js
!src/renderer/connections.js
!src/renderer/workflows.js
# U3 依赖图手写源（同 kanban 先例；core=纯函数/渲染/单测，node:test 直跑不入 dist）
!src/renderer/depgraph.js
!src/renderer/depgraph-core.js
!src/renderer/depgraph-core.test.js
!src/tokens/
!src/tokens/**/*.ts
# 更新缓存对账 + 下载记录（防陈旧差分基假回退）
!src/updater/UpdaterCacheReconciler.ts
!src/updater/UpdaterCacheReconciler.test.ts

# Logs
*.log
npm-debug.log*

# Env / secrets
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Coverage
coverage/

# 构建期 node 下载产物（fetch-node.mjs，根 vendor/）
vendor/
# 豁免：src/renderer/vendor/ = E1 编辑器手动 vendored 资源（easymde/markdown-it/purify + 主题 css），必须入库随壳发布（Q-045 vendoring）
!src/renderer/vendor/
!src/renderer/vendor/**

# 测试产物（S7 e2e）
dist-tests/
test-results/
playwright-report/

# 项目级 opencode 残留（无实际插件代码，仅 SDK 类型依赖空壳；插件走全局配置）
.opencode/

# 图标生成中间产物（源文件 icon.svg/png/icns 保留）
build/icon.iconset/
build/icon.svg.png

# 本地更新源测试配置（HULL_UPDATE_FEED_URL 场景；electron-updater dev 模式读取）
dev-app-update.yml
