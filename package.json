{
  "name": "dsh-hull-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Hull Desktop — 包住官方 DeepSeek Harness (dsh) 的 Electron 桌面壳",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsc && node --test \"dist/**/*.test.js\"",
    "test:integration": "tsc -p tsconfig.tests.json && node --test \"dist-tests/tests/**/*.test.js\"",
    "test:e2e": "tsc && playwright test",
    "verify:acceptance": "node scripts/verify-acceptance.mjs",
    "dev": "tsc && electron ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "electron": "^43.4.0",
    "playwright": "^1.62.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
