# Dependencies
node_modules/

# Build output
dist/
out/
release/
*.tsbuildinfo
# tsc 编译产物（开发期可能就地输出；排除手写 B2 UI 源 src/renderer/kanban.js）
/src/**/*.ts
/src/**/*.d.ts
src/**/*.js
src/**/*.js.map
# 显式保留手写源（覆盖默认）
!src/renderer/kanban.js
!src/renderer/kanban.css
# S1/S2 Skills 子系统手写源（同 kanban 先例；否则新 .ts/.js 静默被忽略不进版本库）
!src/skills/
!src/skills/**/*.ts
!src/renderer/skills.js

# Logs
*.log
npm-debug.log*

# Env / secrets
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Coverage
coverage/

# 构建期 node 下载产物（fetch-node.mjs）
vendor/

# 测试产物（S7 e2e）
dist-tests/
test-results/
playwright-report/
